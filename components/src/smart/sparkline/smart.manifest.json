  "ai_guidance": {
    "use_when": "Use sf-sparkline for the shape of one series beside a number: in a table row, a sentence or the chart slot of sf-metric.",
    "do_not": [
      "Do not use it where a person must read the values; that is sf-line-chart with its axes and table",
      "Do not replace missing values with zero",
      "Do not draw it without a label"
    ],
    "required_reads": [
      "inputs",
      "accessibility"
    ],
    "minimal_example": "<sf-sparkline label=\"Посещения за неделю\"></sf-sparkline>",
    "owner_commands": [
      "node scripts/test.mjs"
    ]
  }
}
