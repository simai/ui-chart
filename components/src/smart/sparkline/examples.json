  "pages": [
    {
      "name": "conformance",
      "title": "sf-sparkline against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
      "format": "the runner is ui-source tests/browser/manifest-probes.browser.mjs, run for the package by scripts/run-manifest-probes.mjs",
      "page": {
        "lang": "ru",
        "body": [
          "<main style=\"inline-size: 40rem\">",
          "  <p>Посещения <sf-sparkline id=\"s\" label=\"Посещения\" y-format=\"integer\"></sf-sparkline></p>",
          "  <sf-sparkline id=\"b\" label=\"Заказы\" shape=\"bar\" mark=\"extremes\"></sf-sparkline>",
          "  <sf-sparkline id=\"e\" label=\"Пусто\"></sf-sparkline>",
          "  <sf-sparkline id=\"l\" label=\"Позже\" data-state=\"loading\"></sf-sparkline>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-image-and-name",
          "title": "an image named by the label and what the data does; no Tab stop",
          "covers": "accessibility (role img, name label), settings.items, settings.summary, settings.y-format",
          "steps": [
            {
              "script": "(() => { document.querySelector('#s').items = [340, 362, 355, 401, 395, 410, 430, 452, 440, 461, 470, 488]; document.querySelector('#b').items = [3, 0, null, 5, 2]; return true; })()",
              "wait": 250,
              "check": "(() => { const s = document.querySelector('#s [role=img]'); return s && s.getAttribute('aria-label') === 'Посещения: от 340 до 488, наибольшее 488, наименьшее 340' && !document.querySelector('#s [tabindex]') && document.querySelectorAll('#s .sf-sparkline-line').length === 1 && document.querySelectorAll('#s .sf-sparkline-mark').length === 1; })()"
            }
          ]
        },
        {
          "id": "p2-bars-and-gaps",
          "title": "bar draws one bar per value, a gap draws none and a zero a hairline; extremes marks the highest and the lowest",
          "covers": "settings.shape, settings.mark, data gaps",
          "steps": [
            {
              "script": "(() => { document.querySelector('#s').items = [340, 362, 355, 401, 395, 410, 430, 452, 440, 461, 470, 488]; document.querySelector('#b').items = [3, 0, null, 5, 2]; return true; })()",
              "wait": 250,
              "check": "(() => { const bars = document.querySelectorAll('#b .sf-sparkline-bar'); return bars.length === 4 && document.querySelectorAll('#b .sf-sparkline-bar--mark').length === 2 && [...bars].every((bar) => Number(bar.getAttribute('height')) >= 1); })()"
            }
          ]
        },
        {
          "id": "p3-empty-and-loading",
          "title": "empty says no data with a dotted baseline; loading holds the box and is busy",
          "covers": "settings.data-state",
          "steps": [
            {
              "script": "(() => { document.querySelector('#s').items = [340, 362, 355, 401, 395, 410, 430, 452, 440, 461, 470, 488]; document.querySelector('#b').items = [3, 0, null, 5, 2]; return true; })()",
              "wait": 250,
              "check": "(() => { const e = document.querySelector('#e [role=img]'); const l = document.querySelector('#l [role=img]'); return e.getAttribute('aria-label') === 'Пусто: нет данных' && document.querySelector('#e .sf-sparkline-empty') && l.getAttribute('aria-busy') === 'true' && l.getBoundingClientRect().height > 0; })()"
            }
          ]
        },
        {
          "id": "p4-summary-none",
          "title": "summary none names the image by its label alone",
          "covers": "settings.summary",
          "steps": [
            {
              "script": "(() => { document.querySelector('#s').items = [340, 362, 355, 401, 395, 410, 430, 452, 440, 461, 470, 488]; document.querySelector('#b').items = [3, 0, null, 5, 2]; document.querySelector('#s').setAttribute('summary', 'none'); return true; })()",
              "wait": 250,
              "check": "(() => document.querySelector('#s [role=img]').getAttribute('aria-label') === 'Посещения')()"
            }
          ]
        }
      ]
    }
  ]
}
