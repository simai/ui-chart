{
  "component": "sf-chart-line",
  "probe": "sf-chart-line against component.json (standard simai.smart-component 1.3.8 §12, gate 20)",
  "format": "the runner is ui-source tests/browser/manifest-probes.browser.mjs, run for the package by scripts/run-manifest-probes.mjs",
  "page": {
    "lang": "ru",
    "body": [
      "<main style=\"inline-size: 40rem\">",
      "  <sf-chart-line id=\"c\" label=\"Продажи и план, 2026\" x=\"month\" y=\"sales,plan\" y-format=\"integer\"></sf-chart-line>",
      "  <sf-chart-line id=\"g\" label=\"Посещения\" x=\"day\" y=\"visits\"></sf-chart-line>",
      "  <sf-chart-line id=\"e\" label=\"Пусто\" data-state=\"error\"></sf-chart-line>",
      "  <sf-chart-line id=\"s\" label=\"Доля каналов\" x=\"month\" y=\"web,shop,partners\" stack=\"normalized\"></sf-chart-line>",
      "</main>"
    ]
  },
  "probes": [
    {
      "id": "p1-figure-and-summary",
      "title": "a figure named by its label; the plot is one group described by a summary of the data",
      "covers": "accessibility (role figure, name label), settings.items, settings.summary",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250,
          "check": "(() => { const f = document.querySelector('#c figure'); const s = document.querySelector('#c svg[role=group]'); const d = document.getElementById(s.getAttribute('aria-describedby')); return f && document.getElementById(f.getAttribute('aria-labelledby')).textContent.trim() === 'Продажи и план, 2026' && s.getAttribute('aria-roledescription') === 'график' && s.tabIndex === 0 && /Продажи: от 120 до 221/u.test(d.textContent) && document.querySelectorAll('#c .sf-chart-line-line').length === 2; })()"
        }
      ]
    },
    {
      "id": "p2-keyboard-cursor",
      "title": "Tab reaches the table button, the legend, then the plot; the arrows move the cursor and each move is said; Enter chooses the point",
      "covers": "keyboard.host (Tab, ArrowRight, ArrowDown, End, Enter, Escape), events.select",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250
        },
        {
          "script": "(document.activeElement?.blur?.(), true)",
          "wait": 60
        },
        {
          "user": "keyboard:Tab",
          "wait": 80,
          "check": "document.activeElement?.classList.contains('sf-chart-line-view')"
        },
        {
          "user": "keyboard:Tab",
          "wait": 60,
          "check": "document.activeElement?.dataset.series === 'sales'"
        },
        {
          "user": "keyboard:Tab",
          "wait": 60,
          "check": "document.activeElement?.dataset.series === 'plan'"
        },
        {
          "user": "keyboard:Tab",
          "wait": 80,
          "check": "document.activeElement === document.querySelector('#c svg[role=group]')"
        },
        {
          "user": "keyboard:ArrowRight",
          "wait": 120,
          "check": "/Продажи: 120$/u.test(document.querySelector('#c [aria-live=polite]').textContent.trim())"
        },
        {
          "user": "keyboard:ArrowDown",
          "wait": 120,
          "check": "/План: 125$/u.test(document.querySelector('#c [aria-live=polite]').textContent.trim())"
        },
        {
          "user": "keyboard:End",
          "wait": 120,
          "check": "/План: 215$/u.test(document.querySelector('#c [aria-live=polite]').textContent.trim()) && document.querySelector('#c .sf-chart-line-tooltip') !== null"
        },
        {
          "user": "keyboard:Enter",
          "expect": {
            "events": [
              {
                "name": "sf-chart-line-select",
                "count": 1,
                "detail": {
                  "series": "plan",
                  "index": 11,
                  "x": "2026-12",
                  "value": 215
                }
              }
            ]
          }
        },
        {
          "user": "keyboard:Escape",
          "wait": 120,
          "check": "document.querySelector('#c .sf-chart-line-tooltip') === null"
        }
      ]
    },
    {
      "id": "p3-legend-toggle",
      "title": "a legend button hides its series and says so: toggle {id, hidden}, hidden-series holds it",
      "covers": "settings.legend, events.toggle, values.hidden-series",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250
        },
        {
          "user": "click:#c .sf-chart-line-legend-item[data-series=plan]",
          "wait": 150,
          "expect": {
            "events": [
              {
                "name": "sf-chart-line-toggle",
                "count": 1,
                "detail": {
                  "id": "plan",
                  "hidden": true
                }
              }
            ]
          },
          "check": "document.querySelectorAll('#c .sf-chart-line-line').length === 1 && document.querySelector('#c .sf-chart-line-legend-item[data-series=plan]').getAttribute('aria-pressed') === 'false' && JSON.stringify(document.querySelector('#c').hiddenSeries) === '[\"plan\"]'"
        },
        {
          "script": "(document.querySelector('#c').reset(), true)",
          "wait": 150,
          "check": "document.querySelectorAll('#c .sf-chart-line-line').length === 2"
        }
      ]
    },
    {
      "id": "p4-table",
      "title": "the table button swaps the plot for the same data as a table, a row per x",
      "covers": "settings.table (toggle)",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250
        },
        {
          "user": "click:#c .sf-chart-line-view",
          "wait": 150,
          "check": "document.querySelector('#c .sf-chart-line-plot').hidden && document.querySelectorAll('#c .sf-chart-line-table tbody tr').length === 12 && document.querySelector('#c .sf-chart-line-table caption').textContent.trim() === 'Продажи и план, 2026'"
        },
        {
          "user": "click:#c .sf-chart-line-view",
          "wait": 150,
          "check": "!document.querySelector('#c .sf-chart-line-plot').hidden"
        }
      ]
    },
    {
      "id": "p5-gap",
      "title": "a missing value is a gap: the line breaks, nothing is drawn at zero",
      "covers": "settings.gaps (break), settings.items",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250
        },
        {
          "check": "(document.querySelector('#g .sf-chart-line-line').getAttribute('d').match(/M/gu) || []).length === 3"
        }
      ]
    },
    {
      "id": "p6-error-refresh",
      "title": "the error state offers «Повторить», which asks for the data again (refresh)",
      "covers": "settings.data-state (error), events.refresh, relations cl-empty-state",
      "steps": [
        {
          "script": "(() => { const c = document.querySelector('#c'); c.names = {sales: 'Продажи', plan: 'План'}; c.items = [{\"month\": \"2026-01\", \"sales\": 120, \"plan\": 125}, {\"month\": \"2026-02\", \"sales\": 132, \"plan\": 130}, {\"month\": \"2026-03\", \"sales\": 128, \"plan\": 135}, {\"month\": \"2026-04\", \"sales\": 150, \"plan\": 145}, {\"month\": \"2026-05\", \"sales\": 171, \"plan\": 160}, {\"month\": \"2026-06\", \"sales\": 165, \"plan\": 165}, {\"month\": \"2026-07\", \"sales\": 180, \"plan\": 175}, {\"month\": \"2026-08\", \"sales\": 176, \"plan\": 180}, {\"month\": \"2026-09\", \"sales\": 190, \"plan\": 185}, {\"month\": \"2026-10\", \"sales\": 204, \"plan\": 195}, {\"month\": \"2026-11\", \"sales\": 198, \"plan\": 205}, {\"month\": \"2026-12\", \"sales\": 221, \"plan\": 215}]; const g = document.querySelector('#g'); g.items = [{\"day\": \"2026-10-01\", \"visits\": 340}, {\"day\": \"2026-10-02\", \"visits\": 362}, {\"day\": \"2026-10-03\", \"visits\": null}, {\"day\": \"2026-10-04\", \"visits\": null}, {\"day\": \"2026-10-05\", \"visits\": 401}, {\"day\": \"2026-10-06\", \"visits\": 395}, {\"day\": \"2026-10-07\", \"visits\": 410}, {\"day\": \"2026-10-08\", \"visits\": null}, {\"day\": \"2026-10-09\", \"visits\": 430}, {\"day\": \"2026-10-10\", \"visits\": 452}, {\"day\": \"2026-10-11\", \"visits\": 440}, {\"day\": \"2026-10-12\", \"visits\": 461}, {\"day\": \"2026-10-13\", \"visits\": 470}, {\"day\": \"2026-10-14\", \"visits\": 488}]; return true; })()",
          "wait": 250
        },
        {
          "wait": 200,
          "user": "click:#e sf-empty-state button",
          "expect": {
            "events": [
              {
                "name": "sf-chart-line-refresh",
                "count": 1
              }
            ]
          }
        }
      ]
    },
    {
      "id": "p7-normalized-layers",
      "title": "normalized stacks the series as layers to 100 %; a gap breaks its layer, and the cursor says the share and the value",
      "covers": "settings.stack, settings.gaps, settings.summary",
      "steps": [
        {
          "script": "(() => { const s = document.querySelector('#s'); s.names = {\"web\": \"Сайт\", \"shop\": \"Магазин\", \"partners\": \"Партнёры\"}; s.items = [{\"month\": \"2026-07\", \"web\": 42, \"shop\": 30, \"partners\": 12}, {\"month\": \"2026-08\", \"web\": 45, \"shop\": 28, \"partners\": 15}, {\"month\": \"2026-09\", \"web\": 51, \"shop\": null, \"partners\": 14}, {\"month\": \"2026-10\", \"web\": 55, \"shop\": 25, \"partners\": 18}, {\"month\": \"2026-11\", \"web\": 58, \"shop\": 24, \"partners\": 20}, {\"month\": \"2026-12\", \"web\": 66, \"shop\": 29, \"partners\": 22}]; return true; })()",
          "wait": 250
        },
        {
          "script": "(document.querySelector('#s').setCursor({index: 0, series: 'web'}, {say: true}), true)",
          "wait": 120,
          "check": "(() => { const s = document.querySelector('#s'); const layers = s.querySelectorAll('.sf-chart-line-area--layer'); const shop = s.querySelector('[data-series=shop] .sf-chart-line-area'); const ticks = [...s.querySelectorAll('.sf-chart-line-tick:not(.sf-chart-line-tick--x)')].map((t) => t.textContent); const live = s.querySelector('[aria-live=polite]').textContent; const summary = document.getElementById(s.querySelector('svg[role=group]').getAttribute('aria-describedby')).textContent; return layers.length === 3 && (shop.getAttribute('d').match(/M/gu) || []).length === 2 && /^100\\s?%$/u.test(ticks[ticks.length - 1]) && /Сайт: 50\\s?%\\s\\(42\\)/u.test(live) && /долями/u.test(summary); })()"
        }
      ]
    }
  ]
}
