{
  "name": "@simai-studio/chart",
  "version": "1.0.3",
  "description": "SIMAI Chart, the component set chart of SIMAI Framework: nineteen chart Smart components (lines, bars, pies, parts, metrics, heatmaps, funnels, gauges, scatter, box plots, radars, candles, waterfalls, treemaps, timelines, Sankey diagrams, sunbursts, choropleth maps and sparklines).",
  "license": "PolyForm-Small-Business-1.0.0 OR PolyForm-Noncommercial-1.0.0 OR LicenseRef-SIMAI-Commercial",
  "author": "Rim Zabarov",
  "homepage": "https://chart.simai.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simai/ui-chart.git",
    "directory": "package"
  },
  "keywords": [
    "simai-framework",
    "component-set",
    "charts",
    "data-visualization",
    "web-components"
  ],
  "files": [
    "dist/",
    "LICENSE.md"
  ],
  "simai": {
    "set": "chart",
    "base": "dist/smart",
    "core": {
      "folder": "chart-core",
      "abi": 1
    }
  },
  "scripts": {
    "overlay": "node scripts/overlay.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/run-browser-probes.mjs",
    "test:manifest": "node scripts/run-manifest-probes.mjs",
    "test:first-paint": "node scripts/run-first-paint.mjs",
    "stage": "node scripts/stage-npm.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
